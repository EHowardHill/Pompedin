{
  "name": "pompedin",
  "version": "1.1.3",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build --config src-tauri/tauri.release.conf.json",
    "build:android": "tauri android build --config src-tauri/tauri.android.conf.json",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:frontend:dev": "node scripts/build-frontend.mjs --no-minify",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "serve": "npx http-server src -p 1420 -c-1",
    "test": "node --test tests/",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bench": "node scripts/benchmark.js",
    "lint": "eslint src/js tests eslint.config.js",
    "lint:errors": "eslint src/js tests eslint.config.js --quiet"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "serve": "^14"
  }
}
